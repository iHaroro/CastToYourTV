<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 允许后台拉起播放页（Android 10+ 后台启动 Activity 的豁免条件） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 声明为电视应用（触屏非必需） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".CastApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.CastToYourTv"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        tools:targetApi="34">

        <!-- 主界面（电视 Launcher 可见） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CastToYourTv"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 投屏播放页（全屏） -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.casttoyourtv.receiver.player"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.CastToYourTv.Fullscreen" />

        <!-- AirPlay 屏幕镜像页（全屏，硬解渲染） -->
        <activity
            android:name=".player.MirrorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.casttoyourtv.receiver.player"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.CastToYourTv.Fullscreen" />

        <!-- AirPlay 音乐播放页（封面 + 曲名 + 已播时长） -->
        <activity
            android:name=".player.AudioPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.casttoyourtv.receiver.player"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.CastToYourTv.Fullscreen" />

        <!-- 投屏接收前台服务（常驻，负责被发现与接收） -->
        <service
            android:name=".CastService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
